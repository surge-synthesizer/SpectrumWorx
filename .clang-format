# SpectrumWorx formatting.
#
# **Pin the version.** clang-format's defaults move between releases, so "the
# tree is clean" is only true against a stated one: this tree was last swept
# with **21.1.5** (05.08.2026), and a different major will re-lay-out files
# nobody touched. scripts/check_format.sh refuses to run against any other
# version, and CI installs 21.1.5 by number rather than taking the runner's.
#
# **A table the build parses needs `// clang-format off`.** WhitespaceSensitiveMacros
# below covers macro *invocations*; it does nothing for a macro *definition*
# whose body is a table, and this tree has one the build reads as data --
# src/le/spectrumworx/effects/configuration/effectsList.hpp, out of which
# tools/show-ui/CMakeLists.txt generates one test per effect. The 05.08.2026
# sweep reflowed it into a staircase and seventeen of those tests silently
# stopped existing. Whitespace-only in C++ is not whitespace-only when something
# other than a compiler reads the file.
#
# The reformat commits are in .git-blame-ignore-revs.
---
BasedOnStyle: LLVM
IndentWidth: 4
---
Language: Cpp
BasedOnStyle: LLVM
IndentWidth: 4
AlignAfterOpenBracket: Align
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel:  true
  AfterClass:      true
  AfterControlStatement: Always
  AfterEnum:       true
  AfterFunction:   true
  AfterNamespace:  true
  AfterObjCDeclaration: true
  AfterStruct:     true
  AfterUnion:      true
  AfterExternBlock: true
  BeforeCatch:     true
  BeforeElse:      true
  BeforeLambdaBody: false
  BeforeWhile:     false
  IndentBraces:    false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true
ColumnLimit: 100
SortIncludes: false
# This tree has order-dependent includes -- finalImplementations.hpp needs
# Module complete, and le/math/vector.cpp's Boost.SIMD block is sequenced -- and
# a dense //...mrmlj... comment style worth preserving verbatim.
ReflowComments: false
AttributeMacros:
  - LE_CDECL
  - LE_COLD
  - LE_CONST_FUNCTION
  - LE_DLL_EXPORT
  - LE_DLL_IMPORT
  - LE_FORCEINLINE
  - LE_HOT
  - LE_NDEBUG_NOVTABLE
  - LE_NOALIAS
  - LE_NOEXCEPT
  - LE_NOINLINE
  - LE_NOTHROW
  - LE_NOTHROWNOALIAS
  - LE_NOTHROWRESTRICTNOALIAS
  - LE_NOVTABLE
  - LE_PURE_FUNCTION
  - LE_RESTRICT
  - LE_RESTRICTNOALIAS
  - LE_WEAK_FUNCTION
  - LE_WEAK_SYMBOL
  - LE_WEAK_SYMBOL_CONST
StatementMacros:
  - LE_DEFAULT_CASE_UNREACHABLE
  - LE_UNREACHABLE_CODE
# A value-string table is one { Value, "string" } pair per line, and its whole
# point is that the pairs line up against the enumerators they name -- reflowed
# into a paragraph it is unreadable and unreviewable.
WhitespaceSensitiveMacros:
  - ENUMERATED_PARAMETER_STRINGS
  - EFFECT_ENUMERATED_PARAMETER_STRINGS
  - ENUMERATED_PARAMETER_SHORT_STRINGS
  - EFFECT_ENUMERATED_PARAMETER_SHORT_STRINGS
---
Language: ObjC
BasedOnStyle: LLVM
IndentWidth: 4
AlignAfterOpenBracket: Align
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel:  true
  AfterClass:      true
  AfterControlStatement: Always
  AfterEnum:       true
  AfterFunction:   true
  AfterNamespace:  true
  AfterObjCDeclaration: true
  AfterStruct:     true
  AfterUnion:      true
  AfterExternBlock: true
  BeforeCatch:     true
  BeforeElse:      true
  BeforeLambdaBody: false
  BeforeWhile:     false
  IndentBraces:    false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true
ColumnLimit: 100
SortIncludes: false
ReflowComments: false
---
